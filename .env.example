# ---------------------------------------------------------------------------
# Firebase — SDK cliente (público, vai para o navegador)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="sua_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu_projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu_projeto_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu_projeto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="seu_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="seu_app_id"

# ---------------------------------------------------------------------------
# Firebase Admin — SERVIDOR (segredo; nunca prefixar com NEXT_PUBLIC_)
# Conta de serviço: Console do Firebase > Configurações > Contas de serviço
# A chave privada vai entre aspas, com os \n literais preservados.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID="seu_projeto_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu_projeto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Anthropic — o cérebro
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# Roteamento por etapa (opcional — os padrões estão em skills/claude-client)
CLAUDE_MODEL_TRIAGEM="claude-haiku-4-5-20251001"
CLAUDE_MODEL_ANALISE="claude-sonnet-5"
CLAUDE_MODEL_REDACAO="claude-opus-5"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://seu-app.netlify.app"

# E-mails com papel de administrador da plataforma, separados por vírgula.
# Usado só no bootstrap, para gravar as custom claims — não é regra de acesso.
PLATAFORMA_ADMINS="cleber.ihs@gmail.com"
