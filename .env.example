# ---------------------------------------------------------------------------
# FRONT (GitHub Pages) — tudo aqui vai para o navegador. Nada de segredo.
# Em produção, estes valores são "Repository variables" no GitHub Actions.
# ---------------------------------------------------------------------------

# Vazio para domínio próprio; "/juridico-ia" se o site for <usuario>.github.io/juridico-ia
NEXT_PUBLIC_BASE_PATH=""

# URL base das Cloud Functions, sem barra no fim. Ex.:
# https://southamerica-east1-juridico-ia-live.cloudfunctions.net
NEXT_PUBLIC_API_BASE_URL="https://southamerica-east1-SEU_PROJETO.cloudfunctions.net"

NEXT_PUBLIC_FIREBASE_API_KEY="sua_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu_projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu_projeto_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu_projeto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="seu_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="seu_app_id"

# ---------------------------------------------------------------------------
# BACKEND (Cloud Functions) — NÃO vai neste arquivo em produção.
#
# A chave da Anthropic é secret do Firebase:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#
# As credenciais do Admin SDK são automáticas dentro das functions — não é preciso
# configurar FIREBASE_PRIVATE_KEY. Só o emulador local precisa de uma conta de
# serviço, via GOOGLE_APPLICATION_CREDENTIALS.
#
# Origens do front autorizadas a chamar as functions (CORS), separadas por vírgula:
#   firebase functions:config nao é usado — defina como variável de ambiente no deploy
#   ou em functions/.env:
# ---------------------------------------------------------------------------
# functions/.env
# ORIGENS_PERMITIDAS="https://seu-usuario.github.io,https://juridico.seudominio.com.br"
# CLAUDE_MODEL_TRIAGEM="claude-haiku-4-5-20251001"
# CLAUDE_MODEL_ANALISE="claude-sonnet-5"
# CLAUDE_MODEL_REDACAO="claude-opus-5"
