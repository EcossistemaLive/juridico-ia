# Variáveis das Cloud Functions (functions/.env — não versionado)
# A chave da Anthropic NÃO fica aqui: é secret do Firebase.
#   firebase functions:secrets:set ANTHROPIC_API_KEY

# Origens do front autorizadas no CORS, separadas por vírgula.
# localhost:3000 já é permitido por padrão.
ORIGENS_PERMITIDAS="https://seu-usuario.github.io,https://juridico.seudominio.com.br"

# Roteamento por etapa (opcional — padrões em skills/claude-client)
CLAUDE_MODEL_TRIAGEM="claude-haiku-4-5-20251001"
CLAUDE_MODEL_ANALISE="claude-sonnet-5"
CLAUDE_MODEL_REDACAO="claude-opus-5"
